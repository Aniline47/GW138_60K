);
  OBUF da_data_out_1_12_obuf (
    .O(da_data_out_1[12]),
    .I(da_data_out_1_d[12]) 
);
  OBUF da_data_out_1_13_obuf (
    .O(da_data_out_1[13]),
    .I(da_data_out_1_d[13]) 
);
  INV clk_out_n_ad_1_d_s0 (
    .O(clk_out_n_ad_1_d_5),
    .I(clk_out_p_ad_2_d) 
);
  INV clk_out_n_da_1_d_s0 (
    .O(clk_out_n_da_1_d_4),
    .I(clk_out_p_da_1_d) 
);
  Gowin_PLL_AD LTC2220_PLL (
    .clk_d(clk_d),
