module AD_DA_test (
  clk,
  rst_n,
  clk_in_ad_1,
  clk_in_ad_2,
  clk_out_p_ad_1,
  clk_out_n_ad_1,
  clk_out_p_ad_2,
  clk_out_n_ad_2,
  clk_out_p_da_1,
  clk_out_n_da_1,
  da_data_out_1,
  i12_ad_data_in_1,
  i12_ad_data_in_2
)
;
input clk;
input rst_n;
input [1:0] clk_in_ad_1;
input [1:0] clk_in_ad_2;
output clk_out_p_ad_1;
output clk_out_n_ad_1;
output clk_out_p_ad_2;
output clk_out_n_ad_2;
output clk_out_p_da_1;
output clk_out_n_da_1;
output [13:0] da_data_out_1;
input [11:0] i12_ad_data_in_1;
input [11:0] i12_ad_data_in_2;
wire clk_d;
wire rst_n_d;
wire clk_out_n_ad_1_d_5;
wire clk_out_n_da_1_d_4;
wire clk_out_p_ad_2_d;
wire clk_out_p_da_1_d;
wire [13:0] da_data_out_1_d;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  OBUF clk_out_p_ad_1_obuf (
    .O(clk_out_p_ad_1),
    .I(clk_out_p_ad_2_d) 
);
  OBUF clk_out_n_ad_1_obuf (
    .O(clk_out_n_ad_1),
    .I(clk_out_n_ad_1_d_5) 
);
  OBUF clk_out_p_ad_2_obuf (
